# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Discord OAuth application used for sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Legacy fallbacks accepted by the application:
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=

# Auth.js session signing key. NEXTAUTH_SECRET is accepted as a legacy fallback.
AUTH_SECRET=
# NEXTAUTH_SECRET=

# Server-only HMAC key used to sign and verify write runs.
WRITE_RUN_SECRET=

# Shared secret for scheduled maintenance requests.
CRON_SECRET=

# Public canonical URL used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=

# Optional public maintainer/contact link shown as “Learn more”.
NEXT_PUBLIC_PERSONAL_PAGE_URL=

# Public Supabase values used by the realtime client, if realtime is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback accepted by the realtime client:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Discord account IDs allowed to open the moderation panel.
MODERATOR_DISCORD_IDS=

# Optional private server-side webhook for neutral report notifications.
DISCORD_REPORT_WEBHOOK_URL=

# Optional database retry window in milliseconds.
DB_RETRY_WINDOW_MS=

# Optional local server port. Defaults to 3000.
# PORT=3000
