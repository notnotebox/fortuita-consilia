# Optional public maintainer/contact link. Leave unset when cloning the project.
NEXT_PUBLIC_PERSONAL_PAGE_URL=

# Public canonical URL used for SEO metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=

# Private Discord webhook used for anonymous message reports. Never expose it
# with NEXT_PUBLIC_ and rotate it if it has been shared publicly.
DISCORD_REPORT_WEBHOOK_URL=

# Comma-separated Discord account IDs allowed to open the moderation panel.
MODERATOR_DISCORD_IDS=
